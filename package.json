{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --workers=1 --headed",
    "test:debug": "npx playwright test --debug",
    "test:slow": "npx playwright test --slow-mo 500 --headed",
    "test:report": "npx playwright show-report",
    "test:ui": "npx playwright test --ui",
    "test:file": "npx playwright test tests/example.spec.ts",
    "test:parallel": "npx playwright test --workers=4",
    "test:serial": "npx playwright test --workers=1",
    "typecheck" : "npx tsc --noEmit"
  },
  "keywords": [],
